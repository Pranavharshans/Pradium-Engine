diff --git a/exllamav3/exllamav3_ext/graph_replay_plan.h b/exllamav3/exllamav3_ext/graph_replay_plan.h
new file mode 100644
--- /dev/null
+++ b/exllamav3/exllamav3_ext/graph_replay_plan.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstddef>
+#include <stdexcept>
+#include <vector>
+
+// Bind an ordered replay argument list once. Repeated IDs are separate sites;
+// never deduplicate them (two GEMMs can patch the same named argument).
+class GraphReplayPlan
+{
+    std::vector<int> layout;
+    std::vector<std::size_t> bindings;
+public:
+    template <typename SiteId, typename ParamId>
+    const std::vector<std::size_t>& bind(std::size_t sites, SiteId site_id,
+                                        std::size_t count, ParamId param_id)
+    {
+        bool same = layout.size() == count;
+        for (std::size_t i = 0; same && i < count; ++i)
+            same = layout[i] == param_id(i);
+        if (same) return bindings;
+
+        std::vector<int> next_layout;
+        std::vector<std::size_t> next_bindings;
+        next_layout.reserve(count);
+        next_bindings.reserve(count);
+        std::size_t cursor = 0;
+        for (std::size_t i = 0; i < count; ++i)
+        {
+            const int id = param_id(i);
+            while (cursor < sites && site_id(cursor) != id) ++cursor;
+            if (cursor == sites)
+                throw std::invalid_argument("Graph replay parameter layout does not match capture");
+            next_layout.push_back(id);
+            next_bindings.push_back(cursor++);
+        }
+        layout.swap(next_layout);
+        bindings.swap(next_bindings);
+        return bindings;
+    }
+};
