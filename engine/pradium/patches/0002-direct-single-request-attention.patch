diff --git a/exllamav3/modules/attention_fn/pradium_policy.py b/exllamav3/modules/attention_fn/pradium_policy.py
new file mode 100644
--- /dev/null
+++ b/exllamav3/modules/attention_fn/pradium_policy.py
@@ -0,0 +1,9 @@
+"""CPU-only selection policy for the experimental direct attention graph."""
+def direct_attention_eligible(*, enabled_limit, bsz, q_len, table_pages,
+                              page_size, head_dim, v_head_dim, qsa):
+    # Use the table capacity, not a CPU readback of live GPU lengths. The extra
+    # query accounts for cache append. Regime 2 has its own graph, so crossing
+    # this boundary safely switches back to the existing split/combine graph.
+    return (enabled_limit > 0 and bsz == 1 and q_len == 1 and not qsa
+            and head_dim == v_head_dim and table_pages > 0
+            and table_pages * page_size + q_len <= enabled_limit)
