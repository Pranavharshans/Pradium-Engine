diff --git a/exllamav3/util/decode_buffers.py b/exllamav3/util/decode_buffers.py
new file mode 100644
--- /dev/null	2026-10-02 17:58:43
+++ b/exllamav3/util/decode_buffers.py	2026-10-02 17:56:49
@@ -0,0 +1,50 @@
+"""Persistent per-module output buffers for the single-token decode path.
+
+A decoded token rebuilds the same small activation tensors in every one of the
+42 layers: the attention input norm output, the attention block output, the MLP
+input norm output and the MLP output. The caching allocator makes each
+allocation cheap in isolation, but at ~168 allocations per decoded token the
+host cost is measurable, and the churning addresses defeat the graph-replay
+pointer comparison that skips unchanged arguments.
+
+``decode_out`` returns one persistent buffer per (owner, key) pair, allocated
+on first use for the exact shape/dtype/device that was requested and reused
+afterwards. It is intentionally only used by the single-token decode path:
+prefill and batched shapes keep allocating, because their shapes vary and the
+per-call allocation cost is amortized over many tokens there.
+
+Safety: a buffer is written by one producer and consumed by the next operation
+on the same stream before the producer runs again; distinct keys never alias,
+so an outstanding read can never be overwritten by a concurrent write.
+"""
+
+from __future__ import annotations
+
+import torch
+
+
+def decode_out(owner, key: str, shape, dtype: torch.dtype, device) -> torch.Tensor:
+    """Persistent output buffer for ``owner`` (a Module), keyed by ``key``."""
+    cache = getattr(owner, "_decode_out_cache", None)
+    if cache is None:
+        cache = {}
+        owner._decode_out_cache = cache
+    t = cache.get(key)
+    if (
+        t is None
+        or tuple(t.shape) != tuple(shape)
+        or t.dtype != dtype
+        or t.device != device
+    ):
+        t = torch.empty(tuple(shape), dtype=dtype, device=device)
+        cache[key] = t
+    return t
+
+
+def reuse(out: torch.Tensor | None, shape, dtype: torch.dtype) -> bool:
+    """True when ``out`` can serve as an output buffer of this shape and dtype."""
+    return (
+        out is not None
+        and tuple(out.shape) == tuple(shape)
+        and out.dtype == dtype
+    )
