diff --git a/exllamav3/modules/attention_fn/pradium_policy.py b/exllamav3/modules/attention_fn/pradium_policy.py
--- a/exllamav3/modules/attention_fn/pradium_policy.py	2026-10-02 17:56:02
+++ b/exllamav3/modules/attention_fn/pradium_policy.py	2026-10-02 21:42:37
@@ -1,9 +1,15 @@
 """CPU-only selection policy for the experimental direct attention graph."""
 def direct_attention_eligible(*, enabled_limit, bsz, q_len, table_pages,
-                              page_size, head_dim, v_head_dim, qsa):
-    # Use the table capacity, not a CPU readback of live GPU lengths. The extra
-    # query accounts for cache append. Regime 2 has its own graph, so crossing
-    # this boundary safely switches back to the existing split/combine graph.
-    return (enabled_limit > 0 and bsz == 1 and q_len == 1 and not qsa
-            and head_dim == v_head_dim and table_pages > 0
-            and table_pages * page_size + q_len <= enabled_limit)
+                              page_size, head_dim, v_head_dim, qsa,
+                              live_tokens = None):
+    # Regime 2 has its own graph, so crossing the bound safely switches back to
+    # the existing split/combine graph. Prefer the precise live context length:
+    # the generator's cache_seqlens staging buffer is pinned host memory, so the
+    # value is available without a GPU-to-CPU readback. Fall back to the padded
+    # block-table bound (an upper bound on the live length) when unavailable.
+    if not (enabled_limit > 0 and bsz == 1 and q_len == 1 and not qsa
+            and head_dim == v_head_dim and table_pages > 0):
+        return False
+    if live_tokens is not None:
+        return live_tokens <= enabled_limit
+    return table_pages * page_size + q_len <= enabled_limit
