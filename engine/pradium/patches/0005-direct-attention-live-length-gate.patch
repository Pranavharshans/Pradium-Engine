             bsz = bsz, q_len = q_len, table_pages = block_table.shape[1],
             page_size = PAGE_SIZE, head_dim = self.head_dim,
             v_head_dim = self.v_head_dim, qsa = self.qsa,
+            live_tokens = (int(host_seqlens[0]) + q_len) if host_seqlens is not None else None,
         ):
             regime = 2
 
